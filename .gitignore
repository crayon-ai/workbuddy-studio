# macOS
.DS_Store

# Claude Code 本地设置（个人配置，不入库）
.claude/settings.local.json

# Node（预留）
node_modules/

# 常见编辑器
.vscode/
.idea/

# 后端：API key（敏感，绝不入库）、build 产物、测试临时文件
server/.env
server/.env.*
server/dist
server/tmp*
.env
.env.*

# 拆解产物（用户数据，每人不同，不入库）
data/teardowns/
# 3.0 多账号产物目录（用户数据，不入库）
data/accounts/
# 笔记复盘录入的原文（用户数据）
data/notes/
# 今日灵感抓取产物（用户数据）
data/inspirations/
# 个性化灵感产物：博主画像 + 灵感抓取（用户数据）
data/personalized/
# 深度复盘产物（用户数据）
data/deep-reviews/

# 本地 worktree 工作区，不入库
.claude/worktrees/
logs/

# brainstorm 可视化会话产物（本地临时，不入库）
.superpowers/

# 启动日志 + 生成的 .app（打包时自动生成，不入库）
WorkBuddy.app/

# 个人资源目录（本地素材，不入库）；PWA 图标与 manifest 是运行必需，保留
assets/*
!assets/manifest.webmanifest
!assets/icon.svg
!assets/icon-192.png
!assets/icon-512.png
!assets/apple-touch-icon.png

# 局域网手机访问 token（敏感，绝不入库）
data/lan-token.txt

# vim 交换文件
*.swp

# 数据同步档（用户数据，每人不同，不入库）
data/sync.json*
